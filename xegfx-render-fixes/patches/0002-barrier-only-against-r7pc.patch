+- (void)nvmtlRefreshSnapshotAtTextureBarrier {
+    nvlog("CDX barrier route: snap %d begun %d depth %d samples %u", _snap != nil, _begun, _passDepth, _passSamples);
+    // Restrict this correction to the observed single-colour, single-sample
+    // snapshot path. Preserve all other existing barrier paths for separate work.
+    BOOL single = YES;
+    for (unsigned i=1; i<NVMTL_NCOL; ++i) if (_pass.col[i]) single=NO;
+    if (!_begun || !_cb->_c.in_rp || !_snap || !_target || !_ps || !single
+        || _passDepth || _pass.ds || _passSamples > 1 || _resolve || _visBuf || _visActive
+        || _target->_parent || _target->_viewParent || _target->_baseLevel || _target->_baseSlice
+        || _pass.col_level[0] || _pass.col_layer[0] || _cb->_c.self_tex) {
+        nvmtl_vk_cmd_barrier(&_cb->_c); return;
+    }
+    NVMTLTexture *root = _target->_parent ?: _target;
+    if ([root nvi]->samples > 1 || [root nvi]->layers > 1 || [root nvi]->mips > 1 || [root nvi]->fmt != [_snap nvi]->fmt
+        || [root nvi]->w != [_snap nvi]->w || [root nvi]->h != [_snap nvi]->h) {
+        nvmtl_vk_cmd_barrier(&_cb->_c); return;
+    }
+    // A pre-pass snapshot cannot satisfy a read-after-write barrier. End the
+    // physical Vulkan pass, refresh that same snapshot, and resume with LOAD.
+    // The logical Metal encoder, resource ownership and state remain intact.
+    NVMTLRenderPipelineState *saved = _ps;
+    const uint32_t oldLoad = _pass.load;
+    nvmtl_vk_cmd_end_render(&_cb->_c); _begun=NO;
+    int rc=nvmtl_vk_cmd_copy_image(&_cb->_c,[root nvi],0,0,[_snap nvi],0,0,[root nvi]->w,[root nvi]->h);
+    _pass.load |= NVMTL_LOAD_ALL;
+    [self setRenderPipelineState:saved];
+    _pass.load=oldLoad;
+    if (rc || !_begun) { [self nvmtlSamplePositionError:@"texture barrier: snapshot refresh/resume failed"]; return; }
+    nvlog("CDX texture barrier refreshed current snapshot and resumed LOAD");
+}
+- (void)textureBarrier { [self nvmtlRefreshSnapshotAtTextureBarrier]; }
